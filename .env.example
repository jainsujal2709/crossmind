# Copy this file to .env for local use. Never commit the real .env file.
DATABASE_URL=sqlite:///./crossmind.db
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_EMAIL=admin@example.com
# At least 8 characters with a letter and a number
ADMIN_PASSWORD=
# Only needed when the frontend is hosted on a different domain than the API
CORS_ORIGINS=http://localhost:8000
# Total size of one upload (all files together). Vercel caps requests at about 4.5 MB regardless of this value.
MAX_UPLOAD_MB=100
# Sign-in lifetime in hours (3 by default, 12 at most)
SESSION_HOURS=3
# Set to "off" only for automated tests
RATE_LIMIT=on
